<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/unnamed"
        android:contentDescription="@null"
        android:alpha="0.96"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/auraOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#3300D4FF"
        android:alpha="0.16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#AA000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASCENDANT SYSTEM"
            android:textColor="#00D4FF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:shadowColor="#00D4FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="25"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/levelPanel"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/step_panel_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleText">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NIVEL"
            android:textColor="#5FAAC2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/tvCurrentLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#00D4FF"
            android:shadowRadius="12"
            android:text="Nivel 0/100"
            android:textColor="#00D4FF"
            android:textSize="28sp"
            android:textStyle="bold" />
        </LinearLayout>

        <!-- Panel Misiones -->
        <LinearLayout
            android:id="@+id/missionsPanel"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/levelPanel">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="⚡"
            android:textSize="42sp"
            android:gravity="center"
            android:textColor="#00D4FF"
            android:shadowColor="#00D4FF"
            android:shadowRadius="15" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY MISSIONS"
                android:textColor="#00D4FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.1"
                android:shadowColor="#00D4FF"
                android:shadowRadius="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete to level up"
                android:textColor="#7799AA"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="›"
            android:textSize="36sp"
            android:gravity="center"
            android:textColor="#00D4FF"
            android:textStyle="bold" />

        </LinearLayout>

        <!-- Panel Logros -->
        <LinearLayout
            android:id="@+id/achievementsPanel"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/missionsPanel">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="✦"
            android:textSize="40sp"
            android:gravity="center"
            android:textColor="#00D4FF"
            android:shadowColor="#00D4FF"
            android:shadowRadius="15" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGROS"
                android:textColor="#00D4FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.1"
                android:shadowColor="#00D4FF"
                android:shadowRadius="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de progreso base"
                android:textColor="#7799AA"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="›"
            android:textSize="36sp"
            android:gravity="center"
            android:textColor="#00D4FF"
            android:textStyle="bold" />

        </LinearLayout>

        <!-- Panel Progreso -->
        <LinearLayout
            android:id="@+id/progressPanel"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/achievementsPanel">

            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="@string/icon_progress"
                android:textSize="40sp"
                android:gravity="center"
                android:textColor="#00D4FF"
                android:shadowColor="#00D4FF"
                android:shadowRadius="15" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_progress_label"
                    android:textColor="#00D4FF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.1"
                    android:shadowColor="#00D4FF"
                    android:shadowRadius="10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_progress_description"
                    android:textColor="#7799AA"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="›"
                android:textSize="36sp"
                android:gravity="center"
                android:textColor="#00D4FF"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
