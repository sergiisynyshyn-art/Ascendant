<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="28dp"
    tools:context=".missionscomplete.MissionCompleteFrameActivity">

    <LinearLayout
        android:id="@+id/levelFramePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/step_panel_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/completionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:lineSpacingExtra="8dp"
            android:shadowColor="#00D4FF"
            android:shadowRadius="26"
            android:text="Has subido de nivel."
            android:textAlignment="center"
            android:textColor="#00D4FF"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:alpha="1" />

        <TextView
            android:id="@+id/currentLevelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="Nivel actual: 1/100"
            android:textColor="#9EDFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:alpha="1" />
    </LinearLayout>

    <Button
        android:id="@+id/enterSystemButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="56dp"
        android:alpha="0"
        android:background="#00D4FF"
        android:text="Enter System"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:alpha="1" />

</RelativeLayout>


