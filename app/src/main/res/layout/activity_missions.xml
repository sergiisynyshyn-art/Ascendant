<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    tools:context=".missions.MissionsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Título y Botón Progreso -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/btnBackMissions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:text="@string/icon_back"
                android:textColor="#00D4FF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvMissionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.15"
                android:shadowColor="#00D4FF"
                android:shadowRadius="25"
                android:text="DAILY MISSIONS"
                android:textColor="#00D4FF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGoToProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:text="@string/icon_progress"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Misión 1: 50 sentadillas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50 Sentadillas"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 2: 50 abdominales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50 Abdominales"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 3: 50 flexiones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50 Flexiones"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 4: 50 barra bíceps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="50 Barra Bíceps"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 5: 10 km Corriendo — Panel con sensor real -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/step_panel_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <!-- Fila superior: checkbox + label + contador mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <CheckBox
                    android:id="@+id/cb_mission_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#00D4FF"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 km Corriendo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/tvStepsMini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 5 km"
                    android:textColor="#00D4FF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Barra de progreso mini -->
            <ProgressBar
                android:id="@+id/pbStepsMini"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/step_progress_drawable"
                android:layout_marginBottom="12dp" />

            <!-- Botón abrir sensor -->
            <Button
                android:id="@+id/btnOpenSteps"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/card_background"
                android:text="▶  VER DISTANCIA EN TIEMPO REAL"
                android:textColor="#00D4FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Misión 6: Meditar 10 minutos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meditar 10 Minutos"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 7: Ducha fría 5 minutos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ducha Fría 5 Minutos"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Misión 8: Lectura 15 minutos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_mission_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lectura 15 Minutos"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMissionDone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#00D4FF"
            android:enabled="false"
            android:text="Misiones hechas"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/debugPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEBUG TOOLS"
                android:textColor="#FF6767"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnDebugSimulateCritical"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#4A1010"
                android:text="SIMULAR 23:55"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDebugSimulateMidnight"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="#102A4A"
                android:text="SIMULAR 00:00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
