<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="30dp"
    tools:context=".nickname.NicknameActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="150dp"
        android:text="CHOOSE YOUR NICKNAME"
        android:textColor="#00D4FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:letterSpacing="0.15"
        android:shadowColor="#00D4FF"
        android:shadowRadius="20"
        android:fontFamily="sans-serif-condensed"
        android:alpha="0"
        tools:alpha="1" />

    <EditText
        android:id="@+id/nicknameInput"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_below="@id/titleText"
        android:layout_marginTop="80dp"
        android:hint="Enter your nickname..."
        android:textColorHint="#44657a"
        android:textColor="#00D4FF"
        android:textSize="20sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/input_border"
        android:maxLines="1"
        android:inputType="text"
        android:alpha="0"
        tools:alpha="1" />

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_below="@id/nicknameInput"
        android:layout_marginTop="40dp"
        android:text="CONFIRM"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"
        android:background="#00D4FF"
        android:alpha="0"
        tools:alpha="1" />

</RelativeLayout>
