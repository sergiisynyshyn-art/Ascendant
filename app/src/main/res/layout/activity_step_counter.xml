<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="56dp"
        android:text="[ SISTEMA DE PASOS ]"
        android:textColor="#00D4FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.12"
        android:shadowColor="#00D4FF"
        android:shadowRadius="18" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvHeader"
        android:layout_marginTop="6dp"
        android:text="MISIÓN DIARIA · 5000 PASOS"
        android:textColor="#2A4A5A"
        android:textSize="12sp"
        android:letterSpacing="0.15" />

    <!-- Panel central -->
    <LinearLayout
        android:id="@+id/stepPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/step_panel_background">

        <!-- Contador principal -->
        <TextView
            android:id="@+id/tvStepCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#00D4FF"
            android:textSize="72sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#00D4FF"
            android:shadowRadius="35" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 5000 PASOS"
            android:textColor="#2A5A6A"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp" />

        <!-- Barra de progreso -->
        <ProgressBar
            android:id="@+id/stepProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/step_progress_drawable"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- Estado de misión -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶  EN PROGRESO"
            android:textColor="#00D4FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:shadowColor="#00D4FF"
            android:shadowRadius="12" />

    </LinearLayout>

    <!-- Aviso sensor no disponible -->
    <TextView
        android:id="@+id/tvSensorWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/stepPanel"
        android:layout_marginTop="20dp"
        android:text=""
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- Botón volver -->
    <Button
        android:id="@+id/btnBackSteps"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/card_background"
        android:text="← VOLVER"
        android:textColor="#00D4FF"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

</RelativeLayout>

