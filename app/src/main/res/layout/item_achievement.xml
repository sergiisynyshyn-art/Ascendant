<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvAchievementName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="Primer Despertar"
        android:textColor="#9AA7B5"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAchievementDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-condensed"
        android:text="Completar misiones por primera vez."
        android:textColor="#6F7D8E"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAchievementStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-condensed"
        android:text="BLOQUEADO"
        android:textColor="#7C8794"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>

